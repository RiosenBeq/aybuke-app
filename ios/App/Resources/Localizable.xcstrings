    "Keeps the biggest face and blurs the others, right on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält das größte Gesicht und macht die anderen unscharf – direkt auf deinem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la cara más grande y desenfoca las demás, en tu propio dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde le plus grand visage et floute les autres, directement sur ton appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mempertahankan wajah terbesar dan mem-blur yang lain, langsung di perangkatmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia il volto più grande e sfoca gli altri, direttamente sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん大きな顔はそのままに、ほかの顔を端末上でぼかします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 큰 얼굴은 그대로 두고 다른 얼굴은 기기에서 바로 흐리게 처리해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o maior rosto e desfoca os outros, direto no seu aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет самое крупное лицо и размывает остальные — прямо на твоём устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En büyük yüzü bırakır, diğerlerini bulanıklaştırır; hem de doğrudan cihazında."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留最大的人脸，并在本机直接模糊其他人脸。"
          }
        }
      }
    },
    "Kept only on this device, and used only to choose what %@ offers." : {
