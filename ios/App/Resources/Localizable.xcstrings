    "Share Glowlit with your besties: a story card with a QR code, or a message with the link." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile Glowlit mit deinen Besties: als Story-Karte mit QR-Code oder als Nachricht mit Link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte Glowlit con tus besties: una tarjeta para historias con un código QR o un mensaje con el enlace."
