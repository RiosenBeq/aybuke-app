    "Find your best selfie, cut the silences out of a video and add 80s & 90s effects. All free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde dein bestes Selfie, schneide Pausen aus Videos und füge 80er- & 90er-Effekte hinzu. Alles gratis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra tu mejor selfie, quita los silencios de un video y añade efectos de los 80 y 90. Todo gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve ton meilleur selfie, coupe les silences d’une vidéo et ajoute des effets années 80 et 90. Tout est gratuit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temukan selfie terbaikmu, potong bagian hening di video, dan tambahkan efek 80-an & 90-an. Semuanya gratis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova il tuo selfie migliore, taglia i silenzi da un video e aggiungi effetti anni '80 e '90. Tutto gratis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベストな自撮りを見つけたり、動画の無音部分をカットしたり、80〜90年代エフェクトを加えたり。すべて無料です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "베스트 셀카를 찾고, 영상의 무음 구간을 잘라내고, 80·90년대 효과도 더해 보세요. 모두 무료예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre sua melhor selfie, corte os silêncios de um vídeo e adicione efeitos anos 80 e 90. Tudo grátis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найди лучшее селфи, убери паузы из видео и добавь эффекты 80-х и 90-х. Всё бесплатно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi selfie'ni bul, videodaki sessizlikleri kes, 80'ler ve 90'lar efektleri ekle. Hepsi ücretsiz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出你的最佳自拍，剪掉视频里的静音，再加上 80/90 年代特效。全部免费。"
          }
        }
      }
    },
