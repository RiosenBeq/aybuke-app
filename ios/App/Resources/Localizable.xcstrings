    "Available in English and Turkish. The KVKK notice applies to people in Türkiye." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfügbar auf Englisch und Türkisch. Der KVKK-Hinweis gilt für Personen in der Türkei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible en inglés y turco. El aviso KVKK se aplica a las personas en Turquía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibles en anglais et en turc. La notice KVKK s’applique aux personnes en Turquie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersedia dalam bahasa Inggris dan Turki. Pemberitahuan KVKK berlaku untuk orang di Türkiye."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
