    },
    "Glowlit follows your iPhone's language. To pick another one, tap Language, then choose it in iOS Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit nutzt die Sprache deines iPhone. Für eine andere tippe auf „Sprache“ und wähl sie dann in den iOS-Einstellungen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit usa el idioma de tu iPhone. Para elegir otro, toca Idioma y luego selecciónalo en Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit suit la langue de ton iPhone. Pour en choisir une autre, appuie sur Langue, puis sélectionne-la dans les Réglages iOS."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit mengikuti bahasa iPhone-mu. Untuk memilih bahasa lain, ketuk Bahasa, lalu pilih di Pengaturan iOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit usa la lingua del tuo iPhone. Per sceglierne un'altra, tocca Lingua e selezionala nelle Impostazioni di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GlowlitはiPhoneの言語設定に合わせて表示されます。別の言語にするには「言語」をタップし、iOSの設定で選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit은 iPhone의 언어 설정을 따라요. 다른 언어를 고르려면 ‘언어’를 탭한 뒤 iOS 설정에서 선택해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Glowlit segue o idioma do seu iPhone. Para escolher outro, toque em Idioma e selecione-o nos Ajustes do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit использует язык твоего iPhone. Чтобы выбрать другой, нажми «Язык» и выбери его в Настройках iOS."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
