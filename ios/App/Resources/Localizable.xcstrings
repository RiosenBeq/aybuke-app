        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efeitos anos 80 e 90, Recortar e Ajustar são grátis e rodam direto no seu celular. Melhorar e Apagar trazem a magia da IA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эффекты 80-х и 90-х, «Вырезать» и «Коррекция» бесплатны и работают прямо на телефоне. «Улучшить» и «Стереть» добавляют магию ИИ."
