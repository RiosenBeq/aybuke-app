    "Our looks are made to keep your face, skin tone and body as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsere Looks sollen dein Gesicht, deinen Hautton und deinen Körper so lassen, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
