    "Pick as many as you like — we'll put them near the top of Explore." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl so viele, wie du magst — wir zeigen sie weit oben in „Entdecken“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige todos los que quieras — los pondremos arriba en Explorar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis-en autant que tu veux — on les mettra en haut d’Explorer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih sebanyak yang kamu mau — kami taruh di bagian atas Jelajahi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegline quanti vuoi — li metteremo in cima a Esplora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きなだけ選んでね — 「見つける」の上のほうに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마음껏 골라 보세요 — ‘둘러보기’ 위쪽에 보여 드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quantos quiser — vamos colocá-los no topo de Explorar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирай сколько хочешь — мы поставим их повыше в «Обзоре»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
