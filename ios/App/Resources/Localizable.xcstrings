        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innerhalb von %@ von unseren Servern gelöscht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan de nuestros servidores en un plazo de %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimées de nos serveurs sous %@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihapus dari server kami dalam %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminate dai nostri server entro %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@以内にサーバーから削除"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이내에 서버에서 삭제돼요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluídas dos nossos servidores em até %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляются с наших серверов в течение %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ içinde sunucularımızdan silinir"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会在 %@内从我们的服务器删除"
          }
        }
      }
    },
    "Deletes your creations and resets every setting on this device, including your AI consent. Subscriptions are managed by Apple and must be cancelled separately." : {

    },
    "Deletes your creations and resets every setting on this device." : {

    },
    "Deletes your creations and your account with its credits from our servers, and resets every setting on this device. Subscriptions are managed by Apple and must be cancelled separately." : {

    },
    "Deletes your creations, your anonymous account and its credits from our servers. Subscriptions are managed by Apple and must be cancelled separately." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht deine Kreationen, dein anonymes Konto und dessen Credits von unseren Servern. Abonnements werden von Apple verwaltet und müssen separat gekündigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina de nuestros servidores tus creaciones, tu cuenta anónima y sus créditos. Las suscripciones las gestiona Apple y deben cancelarse por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tes créations, ton compte anonyme et ses crédits de nos serveurs. Les abonnements sont gérés par Apple et doivent être annulés séparément."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus kreasimu, akun anonimmu, beserta kreditnya dari server kami. Langganan dikelola oleh Apple dan harus dibatalkan secara terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina dai nostri server le tue creazioni, il tuo account anonimo e i relativi crediti. Gli abbonamenti sono gestiti da Apple e vanno disdetti separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作品、匿名アカウントとそのクレジットをサーバーから削除します。サブスクリプションはAppleが管理しているため、別途キャンセルする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 저장된 작품, 익명 계정, 그리고 해당 계정의 크레딧이 삭제돼요. 구독은 Apple에서 관리하므로 별도로 취소해야 해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui suas criações, sua conta anônima e os créditos dela dos nossos servidores. As assinaturas são gerenciadas pela Apple e precisam ser canceladas separadamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет с наших серверов твои работы, анонимный аккаунт и его кредиты. Подписками управляет Apple — их нужно отменить отдельно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eserlerini, anonim hesabını ve bu hesaptaki kredileri sunucularımızdan siler. Abonelikler Apple tarafından yönetilir; ayrıca iptal etmen gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从我们的服务器上删除你的作品、匿名账户及账户中的点数。订阅由 Apple 管理，需另行取消。"
          }
        }
      }
    },
