    "Pro gives you %lld credits every month. Free tools never use credits, and failed edits are always refunded." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
