    "You'll be charged %@ on %@ unless you cancel before." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am %2$@ werden dir %1$@ berechnet, sofern du nicht vorher kündigst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You'll be charged %1$@ on %2$@ unless you cancel before."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se te cobrará %1$@ el %2$@, salvo que canceles antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sera débité le %2$@, sauf si tu annules avant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu akan ditagih %1$@ pada %2$@, kecuali kamu membatalkannya sebelum itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceverai un addebito di %1$@ il %2$@, a meno che tu non disdica prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それまでにキャンセルしない限り、%2$@に%1$@が請求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 전에 취소하지 않으면 %2$@에 %1$@ 결제돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cobrança de %1$@ será feita em %2$@, a menos que você cancele antes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплата %1$@ спишется %2$@, если не отменить подписку раньше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha önce iptal etmezsen %2$@ tarihinde %1$@ tahsil edilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非你在此之前取消，否则将于 %2$@ 向你收取 %1$@。"
          }
        }
      }
    },
    "You'll be charged %@ unless you cancel. Manage it anytime in Settings › Apple Account › Subscriptions." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dir werden %@ berechnet, sofern du nicht kündigst. Verwalte dein Abo jederzeit unter Einstellungen › Apple Account › Abonnements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se te cobrará %@ salvo que canceles. Gestiona tu suscripción cuando quieras en Ajustes › Cuenta de Apple › Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera débité, sauf si tu annules. Gère ton abonnement à tout moment dans Réglages › Compte Apple › Abonnements."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu akan ditagih %@, kecuali kamu membatalkannya. Kelola kapan saja di Pengaturan › Akun Apple › Langganan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceverai un addebito di %@ se non disdici. Gestisci l'abbonamento quando vuoi in Impostazioni › Account Apple › Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセルしない限り、%@が請求されます。設定 › Apple Account › サブスクリプションからいつでも管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소하지 않으면 %@ 결제돼요. 설정 › Apple 계정 › 구독에서 언제든 관리할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cobrança de %@ será feita, a menos que você cancele. Gerencie quando quiser em Ajustes › Conta Apple › Assinaturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплата %@ спишется, если не отменить подписку. Управлять ей можно в любой момент: Настройки › Аккаунт Apple › Подписки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İptal etmezsen %@ tahsil edilecek. Aboneliğini istediğin zaman Ayarlar › Apple Hesabı › Abonelikler bölümünden yönetebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非你取消，否则将向你收取 %@。你可以随时前往“设置 › Apple 账户 › 订阅”进行管理。"
          }
        }
      }
    },
