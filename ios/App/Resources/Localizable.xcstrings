    "Effects, Adjust, Cut out and video editing always stay on this device" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effekte, Anpassen, Freistellen und Videobearbeitung bleiben immer auf diesem Gerät"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los efectos, Ajustar, Recortar y la edición de video siempre se quedan en este dispositivo"
