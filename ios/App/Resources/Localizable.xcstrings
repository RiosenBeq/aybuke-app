    "Light is our signature pink look. Automatic follows your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Hell“ ist unser typischer Pink-Look. „Automatisch“ folgt deinem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claro es nuestro look rosa característico. Automático sigue el modo de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clair, c’est notre look rose signature. Automatique suit les réglages de ton appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terang adalah tampilan pink khas kami. Otomatis mengikuti perangkatmu."
