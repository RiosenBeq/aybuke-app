          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos looks sont conçus pour garder ton visage, ta carnation et ton corps tels qu’ils sont."
          }
        },
        "id" : {
          "stringUnit" : {
