    "Deleted creations stay in Recently deleted for 30 days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Kreationen bleiben 30 Tage in „Zuletzt gelöscht“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las creaciones eliminadas se quedan 30 días en Eliminado recientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les créations supprimées restent 30 jours dans Supprimés récemment."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreasi yang dihapus tetap ada di Baru Dihapus selama 30 hari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le creazioni eliminate restano per 30 giorni in Eliminati di recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除した作品は「最近削除した項目」に30日間保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제한 작품은 ‘최근 삭제된 항목’에 30일 동안 보관돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As criações excluídas ficam 30 dias em Excluídos recentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённые работы хранятся в разделе «Недавно удалённые» 30 дней."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
