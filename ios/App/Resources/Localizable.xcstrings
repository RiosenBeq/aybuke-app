    "Background removal always stays on your iPhone" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrundentfernung bleibt immer auf deinem iPhone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eliminación del fondo siempre se hace en tu iPhone"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le détourage se fait toujours sur ton iPhone"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus latar belakang selalu diproses di iPhone-mu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rimozione dello sfondo resta sempre sul tuo iPhone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景削除は常にiPhone内で完結"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경 제거는 항상 iPhone에서만 처리돼요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A remoção de fundo sempre acontece no seu iPhone"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление фона — всегда только на твоём iPhone"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan kaldırma hep iPhone'unda yapılır"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景移除始终在你的 iPhone 上完成"
          }
        }
      }
    },
    "Background removal and adjustments run on your device. Cloud edits are never used to train AI and are deleted from our servers within %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrundentfernung und Anpassungen laufen auf deinem Gerät. Cloud-Bearbeitungen werden nie zum KI-Training genutzt und innerhalb von %@ von unseren Servern gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La eliminación del fondo y los ajustes se hacen en tu dispositivo. Las ediciones en la nube nunca se usan para entrenar IA y se eliminan de nuestros servidores en un plazo de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le détourage et les ajustements se font sur ton appareil. Les retouches dans le cloud ne servent jamais à entraîner l’IA et sont supprimées de nos serveurs sous %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus latar belakang dan penyesuaian diproses di perangkatmu. Edit lewat cloud tidak pernah dipakai untuk melatih AI dan dihapus dari server kami dalam %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rimozione dello sfondo e le regolazioni avvengono sul tuo dispositivo. Le modifiche nel cloud non vengono mai usate per addestrare l'IA e sono eliminate dai nostri server entro %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景削除と調整は端末上で行われます。クラウドでの編集がAIの学習に使われることはなく、%@以内にサーバーから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경 제거와 조절은 기기에서 실행돼요. 클라우드 편집은 AI 학습에 절대 사용되지 않으며, %@ 이내에 서버에서 삭제돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A remoção de fundo e os ajustes rodam no seu aparelho. As edições na nuvem nunca são usadas para treinar IA e são excluídas dos nossos servidores em até %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление фона и коррекция работают на твоём устройстве. Облачные правки никогда не используются для обучения ИИ и удаляются с наших серверов в течение %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan kaldırma ve ayarlamalar cihazında yapılır. Buluttaki düzenlemeler asla yapay zekâ eğitiminde kullanılmaz ve %@ içinde sunucularımızdan silinir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景移除和调整都在你的设备上运行。云端编辑绝不会用于训练 AI，并会在 %@内从我们的服务器删除。"
          }
        }
      }
    },
