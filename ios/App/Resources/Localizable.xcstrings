    "Your credits stay with your account. Pro stays with the Apple Account that bought it, and Restore purchases brings it back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Credits bleiben bei deinem Konto. Pro bleibt beim Apple Account, mit dem es gekauft wurde, und „Käufe wiederherstellen“ holt es zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus créditos se quedan en tu cuenta. Pro va con la Cuenta de Apple con la que lo compraste, y Restaurar compras lo recupera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes crédits restent liés à ton compte. Pro reste lié au compte Apple qui l’a acheté, et « Restaurer les achats » le récupère."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreditmu tetap tersimpan di akunmu. Pro tetap terhubung ke Akun Apple yang membelinya, dan Pulihkan pembelian akan mengembalikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi crediti restano nel tuo account. Pro resta legato all'Account Apple con cui è stato acquistato e puoi recuperarlo con Ripristina acquisti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クレジットはアカウントに残ります。Proは購入したApple Accountにひも付いており、「購入を復元」で元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크레딧은 계정에 그대로 남아 있어요. Pro는 구매한 Apple 계정에 연결되며, ‘구매 내역 복원’으로 다시 불러올 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus créditos ficam na sua conta. O Pro fica com a Conta Apple que fez a compra, e a opção Restaurar compras o traz de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кредиты остаются в твоём аккаунте. Pro привязан к Аккаунту Apple, с которого его купили, а «Восстановить покупки» вернёт его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kredilerin hesabında kalır. Pro, onu satın alan Apple Hesabına bağlıdır; “Satın alımları geri yükle” ile geri gelir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的点数跟随你的账户。Pro 跟随购买它的 Apple 账户，可通过“恢复购买”找回。"
          }
        }
      }
    },
