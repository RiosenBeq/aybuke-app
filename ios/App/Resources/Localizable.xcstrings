    "Under 16? Check with a parent or guardian first. You can change this anytime in Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter 16? Frag vorher deine Eltern oder Erziehungsberechtigten. Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes menos de 16 años? Consúltalo antes con tu madre, padre o tutor. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as moins de 16 ans ? Parles-en d’abord à un parent ou à un responsable légal. Tu peux modifier ce choix à tout moment dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di bawah 16 tahun? Tanyakan dulu ke orang tua atau walimu. Kamu bisa mengubahnya kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai meno di 16 anni? Chiedi prima a un genitore o tutore. Puoi cambiare questa scelta quando vuoi in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16歳未満の場合は、まず保護者の方に確認してください。この設定は「設定」からいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만 16세 미만이라면 먼저 부모님이나 보호자와 상의해 주세요. 언제든 설정에서 변경할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem menos de 16 anos? Fale com seus pais ou responsável primeiro. Você pode mudar isso quando quiser em Configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тебе нет 16? Сначала посоветуйся с родителем или опекуном. Изменить это можно в любой момент в настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "16 yaşından küçük müsün? Önce ebeveyninle ya da vasinle konuş. Bunu istediğin zaman Ayarlar'dan değiştirebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未满 16 岁？请先征得父母或监护人的同意。你可以随时在“设置”中更改。"
          }
        }
      }
    },
