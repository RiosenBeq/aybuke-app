    "Reporting turns on when %@ launches. Thanks for looking out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden ist möglich, sobald %@ erscheint. Danke, dass du aufpasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los reportes se activarán cuando se lance %@. Gracias por cuidar de los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le signalement sera disponible au lancement de %@. Merci de veiller au grain."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fitur lapor aktif saat %@ resmi rilis. Makasih sudah peduli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le segnalazioni si attiveranno al lancio di %@. Grazie per l'attenzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告機能は%@のリリース時に有効になります。気にかけてくれてありがとう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신고 기능은 %@ 출시 후에 켜져요. 신경 써 줘서 고마워요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As denúncias serão ativadas quando o %@ for lançado. Valeu por ficar de olho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жалобы заработают, когда %@ выйдет. Спасибо за бдительность."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirme özelliği %@ yayınlandığında açılacak. Gözünü dört açtığın için teşekkürler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "举报功能将在 %@ 正式上线时开启。感谢你的留心。"
          }
        }
      }
    },
    "Reports help us review results and improve our safety filters." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldungen helfen uns, Ergebnisse zu prüfen und unsere Sicherheitsfilter zu verbessern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los reportes nos ayudan a revisar resultados y a mejorar nuestros filtros de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes signalements nous aident à vérifier les résultats et à améliorer nos filtres de sécurité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laporan membantu kami meninjau hasil dan menyempurnakan filter keamanan kami."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le segnalazioni ci aiutano a rivedere i risultati e a migliorare i nostri filtri di sicurezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告内容は、結果の確認と安全フィルターの改善に役立てられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신고해 주시면 결과를 검토하고 안전 필터를 개선하는 데 큰 도움이 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As denúncias nos ajudam a revisar resultados e melhorar nossos filtros de segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жалобы помогают нам проверять результаты и улучшать фильтры безопасности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri bildirimlerin, sonuçları incelememize ve güvenlik filtrelerimizi geliştirmemize yardımcı olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "举报能帮助我们审核结果，并改进安全过滤机制。"
          }
        }
      }
    },
