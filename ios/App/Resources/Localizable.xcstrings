          }
        }
      }
    },
    "Tip: try “soft glam”, “pink hair” or “golden hour”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Probier „Soft Glam“, „pinke Haare“ oder „Golden Hour“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: prueba “soft glam”, “pelo rosa” u “hora dorada”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : essaie « soft glam », « cheveux roses » ou « golden hour »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: coba “soft glam”, “rambut pink”, atau “golden hour”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consiglio: prova “soft glam”, “capelli rosa” o “golden hour”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：「ソフトグラム」「ピンクヘア」「ゴールデンアワー」を試してみて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: “소프트 글램”, “핑크 헤어”, “골든아워”를 입력해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: experimente “soft glam”, “cabelo rosa” ou “golden hour”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совет: попробуй «soft glam», «розовые волосы» или «золотой час»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İpucu: “soft glam”, “pembe saç” ya da “gün batımı ışığı” yazmayı dene."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小贴士：试试“柔美妆容”“粉色头发”或“黄金时刻”。"
          }
        }
      }
    },
    "To avoid being charged, cancel before %@ in Settings › Apple Account › Subscriptions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit dir nichts berechnet wird, kündige bis %@ unter Einstellungen › Apple Account › Abonnements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que no se te cobre, cancela antes del %@ en Ajustes › Cuenta de Apple › Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour ne rien payer, annule avant %@ dans Réglages › Compte Apple › Abonnements."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agar tidak ditagih, batalkan sebelum %@ di Pengaturan › Akun Apple › Langganan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per evitare l'addebito, disdici prima del %@ in Impostazioni › Account Apple › Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請求されないようにするには、%@より前に「設定」›「Apple Account」›「サブスクリプション」からキャンセルしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결제되지 않으려면 %@ 전에 설정 › Apple 계정 › 구독에서 취소하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para evitar a cobrança, cancele antes de %@ em Ajustes › Conta Apple › Assinaturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы не платить, отмени подписку до %@: Настройки › Аккаунт Apple › Подписки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücret alınmaması için %@ öncesinde Ayarlar › Apple Hesabı › Abonelikler bölümünden iptal et."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如不想被扣费，请在 %@前前往“设置 › Apple 账户 › 订阅”取消。"
          }
        }
      }
    },
    "To avoid the %@ charge, cancel before %@ in Settings › Apple Account › Subscriptions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit dir die %1$@ nicht berechnet werden, kündige bis %2$@ unter Einstellungen › Apple Account › Abonnements."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To avoid the %1$@ charge, cancel before %2$@ in Settings › Apple Account › Subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que no se te cobren %1$@, cancela antes del %2$@ en Ajustes › Cuenta de Apple › Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour éviter le prélèvement de %1$@, annule avant %2$@ dans Réglages › Compte Apple › Abonnements."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agar tidak ditagih %1$@, batalkan sebelum %2$@ di Pengaturan › Akun Apple › Langganan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per evitare l'addebito di %1$@, disdici prima del %2$@ in Impostazioni › Account Apple › Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の請求を避けるには、%2$@より前に「設定」›「Apple Account」›「サブスクリプション」からキャンセルしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 결제를 피하려면 %2$@ 전에 설정 › Apple 계정 › 구독에서 취소하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para evitar a cobrança de %1$@, cancele antes de %2$@ em Ajustes › Conta Apple › Assinaturas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы не платить %1$@, отмени подписку до %2$@: Настройки › Аккаунт Apple › Подписки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tutarında ücret alınmaması için %2$@ öncesinde Ayarlar › Apple Hesabı › Abonelikler bölümünden iptal et."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如不想被扣费 %1$@，请在 %2$@前前往“设置 › Apple 账户 › 订阅”取消。"
          }
        }
      }
    },
    "To create and edit images with AI, we send the photo and text you choose to our servers and to %@, who process them on our behalf." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Bilder mit KI zu erstellen und zu bearbeiten, senden wir das Foto und den Text, die du auswählst, an unsere Server und an %@, wo sie in unserem Auftrag verarbeitet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para crear y editar imágenes con IA, enviamos la foto y el texto que elijas a nuestros servidores y a %@, donde se procesan en nuestro nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour créer et retoucher des images avec l’IA, nous envoyons la photo et le texte que tu choisis à nos serveurs et à %@, pour un traitement effectué en notre nom."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membuat dan mengedit gambar dengan AI, kami mengirim foto dan teks yang kamu pilih ke server kami dan ke %@, yang memprosesnya atas nama kami."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per creare e modificare immagini con l'IA, la foto e il testo che scegli vengono inviati ai nostri server e a %@ ed elaborati per nostro conto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIで画像を作成・編集するために、あなたが選んだ写真とテキストを当社のサーバー、および当社に代わって処理を行う%@に送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI로 이미지를 만들고 편집할 수 있도록, 선택한 사진과 텍스트를 저희 서버와 %@에 보내요. 해당 업체는 저희를 대신해 이를 처리해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para criar e editar imagens com IA, enviamos a foto e o texto que você escolher para nossos servidores e para %@, que os processam em nosso nome."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы создавать и редактировать изображения с помощью ИИ, мы отправляем выбранные тобой фото и текст на наши серверы и серверы %@, где их обрабатывают по нашему поручению."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ ile görsel oluşturmak ve düzenlemek için seçtiğin fotoğrafı ve metni sunucularımıza gönderir, bizim adımıza işlenmeleri için %@ ile paylaşırız."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了用 AI 创建和编辑图片，我们会将你选择的照片和文字发送到我们的服务器以及%@，由其代表我们进行处理。"
          }
        }
      }
    },
