        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非你在此之前取消，否则将于 %2$@ 向你收取 %1$@。"
          }
        }
      }
    },
    "You'll be charged %@ unless you cancel. Manage it anytime in Settings › Apple Account › Subscriptions." : {
