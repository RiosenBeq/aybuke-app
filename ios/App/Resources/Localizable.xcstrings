    "We couldn't confirm your account, so nothing was deleted. Please contact support and we'll delete it for you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten dein Konto nicht bestätigen, deshalb wurde nichts gelöscht. Bitte kontaktiere den Support, dann löschen wir es für dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos confirmar tu cuenta, así que no se eliminó nada. Contacta con soporte y la eliminaremos por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On n’a pas pu confirmer ton compte, donc rien n’a été supprimé. Contacte l’assistance et on le supprimera pour toi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak bisa memverifikasi akunmu, jadi tidak ada yang dihapus. Silakan hubungi dukungan dan kami akan menghapusnya untukmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non siamo riusciti a confermare il tuo account, quindi non è stato eliminato nulla. Contatta l'assistenza e lo elimineremo noi per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを確認できなかったため、何も削除されていません。サポートにお問い合わせいただければ、こちらで削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 확인하지 못해서 아무것도 삭제되지 않았어요. 고객 지원에 문의해 주시면 저희가 삭제해 드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não conseguimos confirmar sua conta, então nada foi excluído. Fale com o suporte e nós a excluiremos para você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подтвердить твой аккаунт, поэтому ничего не удалено. Напиши в поддержку — мы удалим его за тебя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabını doğrulayamadık, bu yüzden hiçbir şey silinmedi. Lütfen destekle iletişime geç, senin için silelim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们无法确认你的账户，因此没有删除任何内容。请联系客服，我们会帮你删除。"
          }
        }
      }
    },
