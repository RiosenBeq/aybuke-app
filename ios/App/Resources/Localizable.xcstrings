        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이트는 저희 시그니처 핑크 룩이에요. 자동은 iPhone 설정을 따라요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claro é o nosso visual rosa característico. O Automático segue o seu iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Светлое» — наш фирменный розовый стиль. «Авто» — как на твоём iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Açık”, imza pembe görünümümüz. “Otomatik”, iPhone'unun ayarına uyar."
