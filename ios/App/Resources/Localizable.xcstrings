    "Makeup is play. Your face, skin and features stay yours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make-up ist zum Spielen da. Dein Gesicht, deine Haut und deine Züge bleiben deine."
          }
        },
