    "Grids, instant prints, film strips and seamless carousels. Your photos never leave your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raster, Sofortbilder, Filmstreifen und nahtlose Karussells. Deine Fotos verlassen nie dein Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuadrículas, instantáneas, tiras de película y carruseles continuos. Tus fotos nunca salen de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grilles, instantanés, pellicules et carrousels sans raccord. Tes photos ne quittent jamais ton appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grid, foto instan, pita film, dan carousel yang menyambung mulus. Fotomu tidak pernah keluar dari perangkatmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Griglie, istantanee, pellicole e caroselli continui. Le tue foto non lasciano mai il tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グリッド、インスタント写真、フィルム、つながるカルーセルまで。写真が端末の外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그리드, 인스턴트 사진, 필름, 이어지는 캐러셀까지. 사진은 기기 밖으로 나가지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grades, fotos instantâneas, tiras de filme e carrosséis contínuos. Suas fotos nunca saem do seu aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сетки, моментальные фото, плёнки и бесшовные карусели. Фото никогда не покидают твоё устройство."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
