    "We couldn't find a clear face in those photos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten auf diesen Fotos kein klares Gesicht finden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encontramos una cara clara en esas fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On n’a pas trouvé de visage net sur ces photos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak menemukan wajah yang jelas di foto-foto itu."
          }
        },
        "it" : {
