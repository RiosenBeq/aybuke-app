    "Sign in with Apple and Pro and your credits come with you when you switch or add a device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit Apple an und nimm Pro und deine Credits mit, wenn du dein Gerät wechselst oder ein weiteres hinzufügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con Apple y Pro y tus créditos irán contigo cuando cambies de dispositivo o añadas otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi avec Apple : Pro et tes crédits te suivent quand tu changes d’appareil ou en ajoutes un."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk dengan Apple agar Pro dan kreditmu ikut pindah saat kamu ganti atau menambah perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con Apple: Pro e i tuoi crediti ti seguiranno quando cambi o aggiungi un dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleでサインインすれば、端末を買い替えたり追加したりしても、Proとクレジットを引き継げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple로 로그인하면 기기를 바꾸거나 추가해도 Pro와 크레딧이 함께 따라와요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com a Apple para levar o Pro e seus créditos quando trocar de aparelho ou usar mais um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войди через Apple — и Pro с кредитами останутся с тобой, даже если сменишь устройство или добавишь ещё одно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ile giriş yap; cihaz değiştirdiğinde ya da yeni bir cihaz eklediğinde Pro ve kredilerin de seninle gelsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Apple 登录，更换或添加设备时，Pro 和点数都会跟着你。"
          }
        }
      }
    },
    "Sign in with Apple and Pro and your credits come with you when you switch or add a phone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit Apple an und nimm Pro und deine Credits mit, wenn du dein Handy wechselst oder ein weiteres hinzufügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con Apple y Pro y tus créditos irán contigo cuando cambies de teléfono o añadas otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi avec Apple : Pro et tes crédits te suivent quand tu changes de téléphone ou en ajoutes un."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk dengan Apple agar Pro dan kreditmu ikut pindah saat kamu ganti atau menambah ponsel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con Apple: Pro e i tuoi crediti ti seguiranno quando cambi o aggiungi un telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleでサインインすれば、スマホを買い替えたり追加したりしても、Proとクレジットを引き継げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple로 로그인하면 폰을 바꾸거나 추가해도 Pro와 크레딧이 함께 따라와요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com a Apple para levar o Pro e seus créditos quando trocar de celular ou usar mais um."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войди через Apple — и Pro с кредитами останутся с тобой, даже если сменишь телефон или добавишь ещё один."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ile giriş yap; telefon değiştirdiğinde ya da yeni bir telefon eklediğinde Pro ve kredilerin de seninle gelsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Apple 登录，换手机或添加手机时，Pro 和点数都会跟着你。"
          }
        }
      }
    },
    "Sign in with Apple and your credits come with you when you switch or add a device. Pro stays with the Apple Account you subscribed with." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit Apple an und nimm deine Credits mit, wenn du dein Gerät wechselst oder ein weiteres hinzufügst. Pro bleibt bei dem Apple Account, mit dem du es abonniert hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con Apple y tus créditos irán contigo cuando cambies de dispositivo o añadas otro. Pro sigue vinculado a la cuenta de Apple con la que te suscribiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi avec Apple : tes crédits te suivent quand tu changes d’appareil ou en ajoutes un. Pro reste lié au compte Apple qui a souscrit l’abonnement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk dengan Apple agar kreditmu ikut pindah saat kamu ganti atau menambah perangkat. Pro tetap terhubung ke Akun Apple yang kamu pakai untuk berlangganan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con Apple: i tuoi crediti ti seguiranno quando cambi o aggiungi un dispositivo. Pro resta legato all'Account Apple con cui hai sottoscritto l'abbonamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleでサインインすれば、端末を買い替えたり追加したりしてもクレジットを引き継げます。Proは登録したAppleアカウントにひも付いています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple로 로그인하면 기기를 바꾸거나 추가해도 크레딧이 함께 따라와요. Pro는 구독한 Apple 계정에 연결돼 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com a Apple para levar seus créditos quando trocar de aparelho ou usar mais um. O Pro fica com a Conta Apple usada na assinatura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войди через Apple — и кредиты останутся с тобой, даже если сменишь устройство или добавишь ещё одно. Pro привязан к Аккаунту Apple, с которого оформлена подписка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple ile giriş yap; cihaz değiştirdiğinde ya da yeni bir cihaz eklediğinde kredilerin de seninle gelsin. Pro, abone olduğun Apple Hesabı'na bağlı kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Apple 登录，更换或添加设备时，点数都会跟着你。Pro 绑定在你订阅时使用的 Apple 账户上。"
          }
        }
      }
    },
