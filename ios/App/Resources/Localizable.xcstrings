        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiaro è il nostro inconfondibile look rosa. Automatico segue il tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ライト」はおなじみのピンクのデザイン。「自動」は端末の設定に合わせて切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이트는 저희 시그니처 핑크 룩이에요. 자동은 기기 설정을 따라요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claro é o nosso visual rosa característico. O Automático segue o seu aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Светлое» — наш фирменный розовый стиль. «Авто» — как на твоём устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
