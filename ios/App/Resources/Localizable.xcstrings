    "Language, look, privacy and your account live here. Enjoy the glow ✨" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache, Look, Datenschutz und dein Konto findest du hier. Genieß den Glow ✨"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí tienes el idioma, la apariencia, la privacidad y tu cuenta. Disfruta del brillo ✨"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langue, apparence, confidentialité et compte : tout est ici. À toi de briller ✨"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahasa, tampilan, privasi, dan akunmu ada di sini. Selamat glowing ✨"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lingua, aspetto, privacy e il tuo account sono qui. Goditi il glow ✨"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語、外観、プライバシー、アカウントの設定はここから。キラキラを楽しんでね ✨"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어, 화면 모드, 개인정보 보호, 계정 설정은 모두 여기 있어요. 반짝이는 시간 보내세요 ✨"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma, visual, privacidade e sua conta ficam aqui. Aproveite o brilho ✨"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь живут язык, оформление, конфиденциальность и твой аккаунт. Наслаждайся сиянием ✨"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dil, görünüm, gizlilik ve hesabın burada. Işıltının tadını çıkar ✨"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语言、外观、隐私和账户都在这里。尽情闪耀吧 ✨"
          }
        }
      }
    },
