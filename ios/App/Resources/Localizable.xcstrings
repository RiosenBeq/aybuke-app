    "By continuing you agree to our [Terms of Use](%@://terms) and [Privacy Policy](%@://privacy)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du fortfährst, akzeptierst du unsere [Nutzungsbedingungen](%1$@://terms) und unsere [Datenschutzerklärung](%2$@://privacy)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "By continuing you agree to our [Terms of Use](%1$@://terms) and [Privacy Policy](%2$@://privacy)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, aceptas nuestros [Términos de uso](%1$@://terms) y nuestra [Política de privacidad](%2$@://privacy)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En continuant, tu acceptes nos [Conditions d’utilisation](%1$@://terms) et notre [Politique de confidentialité](%2$@://privacy)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan melanjutkan, kamu menyetujui [Ketentuan Penggunaan](%1$@://terms) serta [Kebijakan Privasi](%2$@://privacy) kami."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuando, accetti le nostre [Condizioni d'uso](%1$@://terms) e la nostra [Informativa sulla privacy](%2$@://privacy)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行すると、[利用規約](%1$@://terms)と[プライバシーポリシー](%2$@://privacy)に同意したものとみなされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속하면 [이용 약관](%1$@://terms) 및 [개인정보 처리방침](%2$@://privacy)에 동의하는 것으로 간주돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao continuar, você concorda com nossos [Termos de Uso](%1$@://terms) e nossa [Política de Privacidade](%2$@://privacy)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжая, ты принимаешь наши [Условия использования](%1$@://terms) и [Политику конфиденциальности](%2$@://privacy)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam ederek [Kullanım Koşulları](%1$@://terms) ile [Gizlilik Politikası](%2$@://privacy) metinlerimizi kabul etmiş olursun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续即表示你同意我们的[使用条款](%1$@://terms)和[隐私政策](%2$@://privacy)。"
          }
        }
      }
    },
    "By continuing you confirm you're at least 13 and agree to our [Terms of Use](%@://terms) and [Privacy Policy](%@://privacy)." : {
