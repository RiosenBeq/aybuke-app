            "state" : "translated",
            "value" : "Rêve-le.\n*Vois-le.*"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayangkan.\n*Jadi nyata.*"
          }
        },
