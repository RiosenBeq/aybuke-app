    },
    "This removes every image saved in %@ on this iPhone. Photos you saved to your library stay there." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden alle Bilder gelöscht, die in %@ auf diesem iPhone gespeichert sind. Fotos, die du in deiner Mediathek gesichert hast, bleiben dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina de este iPhone todas las imágenes guardadas en %@. Las fotos guardadas en tu fototeca se quedan ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les images enregistrées dans %@ sur cet iPhone seront supprimées. Les photos enregistrées dans ta photothèque y restent."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus semua gambar yang tersimpan di %@ pada iPhone ini. Foto yang sudah kamu simpan ke aplikasi Foto tetap ada di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimosse tutte le immagini salvate in %@ su questo iPhone. Le foto salvate nella tua libreria resteranno lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneの%@に保存されているすべての画像が削除されます。写真ライブラリに保存した写真はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone의 %@에 저장된 이미지가 모두 삭제돼요. 사진 보관함에 저장한 사진은 그대로 남아 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove todas as imagens salvas no %@ neste iPhone. As fotos que você salvou na sua fototeca continuam lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все изображения, сохранённые в %@ на этом iPhone, будут удалены. Фото, сохранённые в медиатеку, останутся там."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone'da %@ içinde kayıtlı tüm görseller silinir. Fotoğraf arşivine kaydettiğin fotoğraflar orada kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除此 iPhone 上 %@ 中保存的所有图片。你已保存到相册的照片不受影响。"
          }
        }
      }
    },
