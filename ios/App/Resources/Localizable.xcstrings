    "Your skin tone looks darker than in your photo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Hautton wirkt dunkler als auf deinem Foto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tono de piel se ve más oscuro que en tu foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton teint semble plus foncé que sur ta photo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warna kulitmu tampak lebih gelap daripada di foto aslimu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tono della pelle sembra più scuro rispetto alla tua foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肌のトーンが元の写真より暗く見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "피부 톤이 원본 사진보다 어둡게 나왔어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tom de pele parece mais escuro do que na sua foto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тон кожи получился темнее, чем на твоём фото."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cilt tonun fotoğrafındakinden daha koyu görünüyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "肤色看起来比原照片深。"
          }
        }
      }
    },
