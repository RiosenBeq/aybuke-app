        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 걸 설명하고 분위기만 고르세요 — 마법 주문은 저희가 맡을게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva, escolha uma vibe — a gente cuida das palavras mágicas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опиши идею, выбери вайб — волшебные слова подберём мы."
