        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除的作品会在“最近删除”中保留 30 天。"
          }
        }
      }
    },
    "Deleted from our servers within %@" : {
      "localizations" : {
