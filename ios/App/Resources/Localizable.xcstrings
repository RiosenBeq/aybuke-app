    "Tip: be specific — lighting, mood and style words help a lot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Sei konkret — Wörter für Licht, Stimmung und Stil helfen sehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: da detalles — hablar de luz, ambiente y estilo ayuda mucho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : donne des détails — lumière, ambiance, style… ça aide beaucoup."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: tulis sedetail mungkin — kata soal cahaya, suasana, dan gaya sangat membantu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consiglio: entra nei dettagli — parole su luce, atmosfera e stile aiutano tanto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：具体的に書くのがコツ — 光、雰囲気、スタイルを表す言葉がとても効果的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 구체적으로 적어 보세요 — 조명, 분위기, 스타일을 표현하는 단어가 큰 도움이 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: dê detalhes — palavras sobre luz, clima e estilo ajudam muito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совет: пиши конкретно — слова про свет, настроение и стиль очень помогают."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İpucu: ayrıntılı yaz — ışık, atmosfer ve stil kelimeleri çok işe yarar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小贴士：描述越具体越好——光线、氛围和风格词都很有帮助。"
          }
        }
      }
    },
    "Tip: hold the photo to compare with your original." : {
