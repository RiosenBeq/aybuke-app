    "Every tool here runs on your device. Your photos are never uploaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Tool hier läuft auf deinem Gerät. Deine Fotos werden nie hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí todas las herramientas funcionan en tu dispositivo. Tus fotos nunca se suben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque outil ici fonctionne sur ton appareil. Tes photos ne sont jamais envoyées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua alat di sini berjalan di perangkatmu. Fotomu tidak pernah diunggah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui ogni strumento funziona sul tuo dispositivo. Le tue foto non vengono mai caricate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここにあるツールはすべて端末上で動作します。写真がアップロードされることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 있는 도구는 모두 기기에서 실행돼요. 사진은 절대 업로드되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as ferramentas daqui rodam no seu aparelho. Suas fotos nunca são enviadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все инструменты здесь работают на твоём устройстве. Фото никогда не загружаются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buradaki her araç cihazında çalışır. Fotoğrafların asla yüklenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里的所有工具都在你的设备上运行，你的照片绝不会被上传。"
          }
        }
      }
    },
