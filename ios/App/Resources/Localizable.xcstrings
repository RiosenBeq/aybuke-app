    "Light is our signature pink look. Automatic follows your iPhone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Hell“ ist unser typischer Pink-Look. „Automatisch“ folgt deinem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claro es nuestro look rosa característico. Automático sigue el modo de tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clair, c’est notre look rose signature. Automatique suit les réglages de ton iPhone."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terang adalah tampilan pink khas kami. Otomatis mengikuti iPhone-mu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiaro è il nostro inconfondibile look rosa. Automatico segue il tuo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ライト」はおなじみのピンクのデザイン。「自動」はiPhoneの設定に合わせて切り替わります。"
