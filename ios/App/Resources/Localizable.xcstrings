    "About half what most AI photo apps charge. No weekly plans, ever." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa halb so teuer wie die meisten KI-Foto-Apps. Niemals Wochen-Abos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de la mitad de lo que cobran la mayoría de las apps de fotos con IA. Y nunca planes semanales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ deux fois moins cher que la plupart des apps photo IA. Jamais d’abonnement à la semaine."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekitar separuh harga kebanyakan aplikasi foto AI. Tak akan pernah ada paket mingguan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa la metà del prezzo della maggior parte delle app foto con IA. Niente piani settimanali, mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般的なAI写真アプリのおよそ半額。週額プランは今後も一切ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 AI 사진 앱 요금의 절반 수준이에요. 주간 요금제는 앞으로도 절대 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca da metade do preço da maioria dos apps de foto com IA. Nada de planos semanais, nunca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примерно вдвое дешевле большинства ИИ-фотоприложений. И никаких недельных подписок — никогда."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoğu yapay zekâ fotoğraf uygulamasının yaklaşık yarı fiyatına. Haftalık abonelik asla yok."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "价格约为多数 AI 修图 App 的一半。永远不设周订阅。"
          }
        }
      }
    },
