    "You get %lld free credits every day. Background removal and adjustments are always free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst jeden Tag %lld Gratis-Credits. Hintergrundentfernung und Anpassungen sind immer gratis."
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You get %lld free credit every day. Background removal and adjustments are always free."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You get %lld free credits every day. Background removal and adjustments are always free."
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes %lld créditos gratis cada día. La eliminación del fondo y los ajustes siempre son gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reçois %lld crédits gratuits par jour. Le détourage et les ajustements sont toujours gratuits."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu dapat %lld kredit gratis setiap hari. Hapus latar belakang dan penyesuaian selalu gratis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi %lld crediti gratis ogni giorno. La rimozione dello sfondo e le regolazioni sono sempre gratis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日%lldクレジットが無料でもらえます。背景削除と調整はいつでも無料です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 %lld크레딧을 무료로 드려요. 배경 제거와 조절은 언제나 무료예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ganha %lld créditos grátis todo dia. A remoção de fundo e os ajustes são sempre grátis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатных кредитов в день: %lld. Удаление фона и коррекция — всегда бесплатно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her gün %lld ücretsiz kredi alırsın. Arka plan kaldırma ve ayarlamalar her zaman ücretsiz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你每天可获得 %lld 个免费点数。背景移除和调整始终免费。"
          }
        }
      }
    },
    "You get %lld free credits every day. Free tools never use credits, and failed edits are always refunded." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You get %lld free credit every day. Free tools never use credits, and failed edits are always refunded."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You get %lld free credits every day. Free tools never use credits, and failed edits are always refunded."
                }
              }
            }
          }
        }
      }
    },
    "You get 3 free credits every day. Free tools never use credits, and failed edits are always refunded." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst jeden Tag 3 Gratis-Credits. Gratis-Tools verbrauchen nie Credits, und fehlgeschlagene Bearbeitungen werden immer erstattet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes 3 créditos gratis cada día. Las herramientas gratis nunca gastan créditos y, si una edición falla, siempre recuperas el crédito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reçois 3 crédits gratuits par jour. Les outils gratuits n’utilisent jamais de crédits, et les retouches échouées sont toujours remboursées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu dapat 3 kredit gratis setiap hari. Alat gratis tidak pernah memakai kredit, dan kredit edit yang gagal selalu dikembalikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi 3 crediti gratis ogni giorno. Gli strumenti gratuiti non usano mai crediti e le modifiche non riuscite vengono sempre rimborsate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日3クレジットが無料でもらえます。無料ツールではクレジットを使わず、失敗した編集のクレジットは必ず返却されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일 3크레딧을 무료로 드려요. 무료 도구는 크레딧을 쓰지 않고, 실패한 편집은 언제나 환불돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ganha 3 créditos grátis todo dia. As ferramentas grátis nunca gastam créditos, e edições com falha sempre têm o crédito devolvido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый день у тебя 3 бесплатных кредита. Бесплатные инструменты не тратят кредиты, а за неудачные правки они всегда возвращаются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her gün 3 ücretsiz kredi alırsın. Ücretsiz araçlar asla kredi harcamaz, başarısız düzenlemelerin kredisi de her zaman iade edilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你每天可获得 3 个免费点数。免费工具不消耗点数，编辑失败也一律退还点数。"
          }
        }
      }
    },
