        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu akan ditagih %1$@ pada %2$@, kecuali kamu membatalkannya sebelum itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riceverai un addebito di %1$@ il %2$@, a meno che tu non disdica prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それまでにキャンセルしない限り、%2$@に%1$@が請求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 전에 취소하지 않으면 %2$@에 %1$@ 결제돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cobrança de %1$@ será feita em %2$@, a menos que você cancele antes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оплата %1$@ спишется %2$@, если не отменить подписку раньше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha önce iptal etmezsen %2$@ tarihinde %1$@ tahsil edilir."
