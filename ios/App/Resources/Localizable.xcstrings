    "Pro includes %lld credits every month; unused credits roll over one month. Failed creations are refunded automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro enthält jeden Monat %lld Credits; ungenutzte Credits bleiben einen Monat länger gültig. Fehlgeschlagene Kreationen werden automatisch erstattet."
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pro includes %lld credit every month; unused credits roll over one month. Failed creations are refunded automatically."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pro includes %lld credits every month; unused credits roll over one month. Failed creations are refunded automatically."
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro incluye %lld créditos al mes; los que no uses se conservan un mes más. Si una creación falla, el crédito se te devuelve automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro inclut %lld crédits par mois ; les crédits non utilisés restent valables un mois de plus. Les créations échouées sont remboursées automatiquement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro mencakup %lld kredit setiap bulan; kredit yang tidak terpakai masih berlaku hingga satu bulan berikutnya. Kredit untuk kreasi yang gagal dikembalikan secara otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro include %lld crediti al mese; i crediti non usati restano validi per un altro mese. Le creazioni non riuscite vengono rimborsate automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proには毎月%lldクレジットが含まれます。使わなかったクレジットは翌月まで繰り越せます。失敗した作成のクレジットは自動で返却されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro에는 매달 %lld크레딧이 포함돼요. 쓰지 않은 크레딧은 한 달 동안 이월돼요. 생성에 실패하면 크레딧이 자동으로 환불돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Pro inclui %lld créditos por mês; os créditos não usados valem por mais um mês. Criações com falha têm o crédito devolvido automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кредитов в месяц в Pro: %lld. Неиспользованные переносятся на один месяц. За неудачные генерации кредиты возвращаются автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro ile her ay %lld kredi alırsın; kullanılmayan krediler bir ay daha geçerli kalır. Başarısız eserlerin kredisi otomatik olarak iade edilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 每月包含 %lld 点数；未用完的点数可顺延一个月。创作失败会自动退还点数。"
          }
        }
      }
    },
