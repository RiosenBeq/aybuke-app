          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облачный ИИ немного отдыхает до %@. Эффекты, Retro Cam, «Вырезать» и другие бесплатные инструменты по-прежнему работают."
          }
        },
        "tr" : {
          "stringUnit" : {
