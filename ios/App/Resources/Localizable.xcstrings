    "My Works couldn't open, so new creations won't be kept this time. Free up some space and restart Glowlit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Meine Werke“ ließ sich nicht öffnen, deshalb werden neue Kreationen diesmal nicht gespeichert. Mach etwas Speicherplatz frei und starte Glowlit neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir Mis creaciones, así que esta vez no se guardarán las nuevas creaciones. Libera espacio y reinicia Glowlit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir Mes créations : tes nouvelles créations ne seront pas conservées cette fois. Libère de l’espace et redémarre Glowlit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karyaku tidak bisa dibuka, jadi kreasi baru tidak akan disimpan kali ini. Kosongkan sedikit ruang dan buka ulang Glowlit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire Le mie opere, quindi questa volta le nuove creazioni non verranno salvate. Libera spazio e riavvia Glowlit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイ作品を開けなかったため、今回は新しい作品が保存されません。空き容量を増やしてから、Glowlitを再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 작품을 열지 못해서 이번에는 새 작품이 저장되지 않아요. 저장 공간을 확보한 뒤 Glowlit을 다시 시작해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir Minhas criações, então as novas criações não serão guardadas desta vez. Libere espaço e reinicie o Glowlit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось открыть «Мои работы», поэтому новые работы в этот раз не сохранятся. Освободи место и перезапусти Glowlit."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eserlerim açılamadı, bu yüzden yeni eserlerin bu sefer saklanmayacak. Biraz yer aç ve Glowlit'i yeniden başlat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开“我的作品”，所以这次的新作品不会被保存。请释放一些空间后重新启动 Glowlit。"
          }
        }
      }
    },
