    "Waiting for approval. If it's approved, Pro turns on automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten auf Zustimmung. Wird der Kauf genehmigt, wird Pro automatisch aktiviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando aprobación. Si la aprueban, Pro se activará automáticamente."
