    "AI is taking a short break. Please try again later. Your free tools still work." : {
      "comment" : "Error message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI macht gerade eine kurze Pause. Bitte versuch es später noch einmal. Deine Gratis-Tools funktionieren weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA se está tomando un breve descanso. Inténtalo de nuevo más tarde. Tus herramientas gratis siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA fait une courte pause. Réessaie plus tard. Tes outils gratuits fonctionnent toujours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI sedang istirahat sebentar. Coba lagi nanti ya. Alat gratismu tetap bisa dipakai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA si sta prendendo una breve pausa. Riprova più tardi. I tuoi strumenti gratis funzionano ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIは少し休憩中です。しばらくしてからもう一度お試しください。無料ツールはそのまま使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI가 잠깐 쉬고 있어요. 나중에 다시 시도해 주세요. 무료 도구는 계속 쓸 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A IA está fazendo uma pausa rápida. Tente de novo mais tarde. Suas ferramentas grátis continuam funcionando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ ненадолго взял паузу. Попробуй позже. Бесплатные инструменты по-прежнему работают."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ kısa bir mola veriyor. Lütfen daha sonra tekrar dene. Ücretsiz araçların çalışmaya devam ediyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 正在短暂休息，请稍后再试。免费工具仍可使用。"
          }
        }
      }
    },
    "Cloud AI is taking a little break for now. Your free tools still work in the meantime." : {
      "comment" : "Error message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Cloud-KI macht gerade eine kleine Pause. Deine Gratis-Tools funktionieren in der Zwischenzeit weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA en la nube se está tomando un pequeño descanso. Mientras tanto, tus herramientas gratis siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA dans le cloud fait une petite pause. En attendant, tes outils gratuits fonctionnent toujours."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI cloud sedang istirahat sebentar. Sementara itu, alat gratismu tetap bisa dipakai."
