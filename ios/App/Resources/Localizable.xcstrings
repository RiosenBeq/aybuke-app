    "We didn't hear any words. Add your own at any moment of the video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben keine Worte gehört. Füge an jeder Stelle des Videos eigene hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
