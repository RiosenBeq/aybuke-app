    "Check every face. Tap to hide any we missed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüf jedes Gesicht. Tipp, um übersehene zu verbergen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa cada cara. Toca para ocultar las que se nos hayan pasado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie chaque visage. Touche pour masquer ceux qu’on a ratés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cek setiap wajah. Ketuk untuk menyembunyikan yang terlewat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla ogni volto. Tocca per nascondere quelli che ci sono sfuggiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての顔を確認してね。見落としがあればタップして隠せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 얼굴을 확인해 주세요. 놓친 얼굴은 탭해서 가릴 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira cada rosto. Toque para ocultar algum que tenha passado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверь каждое лицо. Нажми, чтобы скрыть пропущенные."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yüzü kontrol et. Gözümüzden kaçanı gizlemek için dokun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查每张脸。如有遗漏，轻点即可遮挡。"
          }
        }
      }
    },
    "Check your internet connection and try again." : {
