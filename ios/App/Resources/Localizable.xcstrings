    "Tap Add captions and the words you say appear on your video. Then fix a word or pick a style in Edit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Untertitel hinzufügen“ und deine Worte erscheinen im Video. Dann korrigiere ein Wort oder wähle unter „Bearbeiten“ einen Stil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Añadir subtítulos y lo que dices aparecerá en tu video. Luego corrige una palabra o elige un estilo en Editar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie sur Ajouter des sous-titres et tes paroles apparaissent sur ta vidéo. Ensuite, corrige un mot ou choisis un style dans Modifier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Tambah subtitle dan kata-kata yang kamu ucapkan muncul di videomu. Lalu perbaiki kata atau pilih gaya di Edit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Aggiungi sottotitoli e le parole che dici appaiono nel video. Poi correggi una parola o scegli uno stile in Modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「字幕をつける」をタップすると、話した言葉が動画に表示されます。言葉の修正やスタイル選びは「編集」から。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘자막 넣기’를 탭하면 말한 내용이 동영상에 자막으로 나타나요. 단어를 고치거나 스타일을 고르려면 ‘편집’을 탭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Adicionar legendas e o que você fala aparece no vídeo. Depois, corrija uma palavra ou escolha um estilo em Editar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажми «Добавить субтитры» — и твои слова появятся на видео. Потом исправь слово или выбери стиль в «Изменить»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Altyazı ekle”ye dokun, söylediğin sözler videonda belirsin. Sonra “Düzenle”de bir kelimeyi düzelt ya da bir stil seç."
