    "Shoot with live 80s, 90s and Y2K effects, or start a four-shot photo booth. Free, on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografiere mit Live-Effekten aus den 80ern, 90ern und Y2K oder starte eine Fotobox mit vier Fotos. Gratis, auf deinem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispara con efectos de los 80, los 90 y Y2K en vivo, o inicia un fotomatón de cuatro fotos. Gratis, en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prends des photos avec des effets années 80, 90 et Y2K en direct, ou lance un photomaton de quatre photos. Gratuit, sur ton appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto dengan efek 80-an, 90-an, dan Y2K secara live, atau mulai photobooth empat jepretan. Gratis, di perangkatmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta con effetti anni '80, '90 e Y2K in tempo reale o avvia una cabina fotografica da quattro scatti. Gratis, sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "80年代・90年代・Y2Kのエフェクトをライブでかけて撮影したり、4枚撮りのフォトブースを始めたり。無料・端末内で処理。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "80·90년대와 Y2K 효과를 실시간으로 입혀 찍거나, 네 컷 포토부스를 시작해 보세요. 무료, 기기에서 처리돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotografe com efeitos anos 80, 90 e Y2K ao vivo ou comece uma cabine de fotos com quatro cliques. Grátis, no seu aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимай с живыми эффектами 80-х, 90-х и Y2K или запусти фотобудку на четыре кадра. Бесплатно, на твоём устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı 80'ler, 90'lar ve Y2K efektleriyle çek ya da dört karelik bir fotoğraf kabini başlat. Ücretsiz, cihazında."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用实时 80、90 年代和 Y2K 特效拍照，或开启四连拍大头贴。免费，本机处理。"
          }
        }
      }
    },
