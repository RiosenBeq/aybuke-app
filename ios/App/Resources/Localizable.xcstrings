        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "베프에게 Glowlit을 공유하세요. QR 코드가 담긴 스토리 카드나 링크가 담긴 메시지로 보낼 수 있어요."
          }
        },
        "pt-BR" : {
