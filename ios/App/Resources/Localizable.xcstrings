    "Glowlit follows your device's language. To pick another one, tap Language, then choose it in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit nutzt die Sprache deines Geräts. Für eine andere tippe auf „Sprache“ und wähl sie dann in den Einstellungen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit usa el idioma de tu dispositivo. Para elegir otro, toca Idioma y luego selecciónalo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit suit la langue de ton appareil. Pour en choisir une autre, appuie sur Langue, puis sélectionne-la dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit mengikuti bahasa perangkatmu. Untuk memilih bahasa lain, ketuk Bahasa, lalu pilih di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit usa la lingua del tuo dispositivo. Per sceglierne un'altra, tocca Lingua e selezionala in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlitは端末の言語設定に合わせて表示されます。別の言語にするには「言語」をタップし、設定で選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit은 기기의 언어 설정을 따라요. 다른 언어를 고르려면 ‘언어’를 탭한 뒤 설정에서 선택해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Glowlit segue o idioma do seu aparelho. Para escolher outro, toque em Idioma e selecione-o nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit использует язык твоего устройства. Чтобы выбрать другой, нажми «Язык» и выбери его в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit, cihazının dilini kullanır. Başka bir dil seçmek için Dil'e dokun, ardından Ayarlar'da seç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit 会跟随你的设备语言。如需选择其他语言，请轻点“语言”，然后在设置中选择。"
          }
        }
      }
    },
    "Glowlit follows your iPhone's language. To pick another one, tap Language, then choose it in iOS Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit nutzt die Sprache deines iPhone. Für eine andere tippe auf „Sprache“ und wähl sie dann in den iOS-Einstellungen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit usa el idioma de tu iPhone. Para elegir otro, toca Idioma y luego selecciónalo en Ajustes de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glowlit suit la langue de ton iPhone. Pour en choisir une autre, appuie sur Langue, puis sélectionne-la dans les Réglages iOS."
