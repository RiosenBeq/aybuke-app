    "Everything you make stays on your device. Heart your favorites and share in one tap." : {

    },
    "Everything you make stays on your iPhone. Heart your favorites and share in one tap." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was du erstellst, bleibt auf deinem iPhone. Markiere Favoriten mit einem Herz und teile mit nur einem Tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que creas se queda en tu iPhone. Dale corazón a tus favoritas y compártelas con un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que tu crées reste sur ton iPhone. Mets un cœur à tes préférées et partage-les en un geste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua yang kamu buat tetap di iPhone-mu. Beri tanda hati pada favoritmu dan bagikan dengan sekali ketuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che crei resta sul tuo iPhone. Metti il cuore alle tue preferite e condividi con un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つくった作品はすべてiPhoneの中に保存されます。お気に入りにはハートをつけて、ワンタップでシェア。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만든 작품은 모두 iPhone에 저장돼요. 마음에 드는 작품엔 하트를 누르고, 탭 한 번으로 공유하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que você cria fica no seu iPhone. Marque suas favoritas com um coração e compartilhe com um toque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё, что ты создаёшь, остаётся на твоём iPhone. Отмечай любимое сердечком и делись в один тап."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaptığın her şey iPhone'unda kalır. Favorilerini kalple işaretle, tek dokunuşla paylaş."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你创作的一切都保存在你的 iPhone 上。给喜欢的作品点 ♡，一键就能分享。"
          }
        }
      }
    },
