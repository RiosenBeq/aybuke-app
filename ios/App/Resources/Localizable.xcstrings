    "Tip: be specific — lighting, mood and style words help a lot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Sei konkret — Wörter für Licht, Stimmung und Stil helfen sehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: da detalles — hablar de luz, ambiente y estilo ayuda mucho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : donne des détails — lumière, ambiance, style… ça aide beaucoup."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: tulis sedetail mungkin — kata soal cahaya, suasana, dan gaya sangat membantu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consiglio: entra nei dettagli — parole su luce, atmosfera e stile aiutano tanto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：具体的に書くのがコツ — 光、雰囲気、スタイルを表す言葉がとても効果的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 구체적으로 적어 보세요 — 조명, 분위기, 스타일을 표현하는 단어가 큰 도움이 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: dê detalhes — palavras sobre luz, clima e estilo ajudam muito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совет: пиши конкретно — слова про свет, настроение и стиль очень помогают."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İpucu: ayrıntılı yaz — ışık, atmosfer ve stil kelimeleri çok işe yarar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小贴士：描述越具体越好——光线、氛围和风格词都很有帮助。"
          }
        }
      }
    },
    "Tip: hold the photo to compare with your original." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tipp: Halte das Foto gedrückt, um es mit dem Original zu vergleichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: mantén presionada la foto para compararla con la original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : maintiens le doigt sur la photo pour la comparer à l’original."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tips: tahan fotonya untuk membandingkan dengan aslinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consiglio: tieni premuta la foto per confrontarla con l'originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヒント：写真を長押しすると、元の写真と比べられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁: 사진을 길게 누르면 원본과 비교할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dica: segure a foto para comparar com a original."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совет: удерживай фото, чтобы сравнить с оригиналом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
