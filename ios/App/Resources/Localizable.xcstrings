      }
    },
    "Deletes your creations and resets every setting on this device, including your AI consent. Subscriptions are managed by Apple and must be cancelled separately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht deine Kreationen und setzt alle Einstellungen auf diesem Gerät zurück, auch deine KI-Einwilligung. Abonnements werden von Apple verwaltet und müssen separat gekündigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tus creaciones y restablece todos los ajustes de este dispositivo, incluido tu consentimiento para la IA. Las suscripciones las gestiona Apple y deben cancelarse por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tes créations et réinitialise tous les réglages de cet appareil, y compris ton accord pour l’IA. Les abonnements sont gérés par Apple et doivent être annulés séparément."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus kreasimu dan mengatur ulang semua pengaturan di perangkat ini, termasuk persetujuan AI-mu. Langganan dikelola oleh Apple dan harus dibatalkan secara terpisah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina le tue creazioni e ripristina tutte le impostazioni su questo dispositivo, compreso il consenso all'IA. Gli abbonamenti sono gestiti da Apple e vanno disdetti separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作品を削除し、AI処理への同意を含むこの端末のすべての設定をリセットします。サブスクリプションはAppleが管理しているため、別途キャンセルする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작품을 삭제하고 AI 처리 동의를 포함해 이 기기의 모든 설정을 초기화해요. 구독은 Apple에서 관리하므로 별도로 취소해야 해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui suas criações e redefine todas as configurações deste aparelho, incluindo seu consentimento de IA. As assinaturas são gerenciadas pela Apple e precisam ser canceladas separadamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет твои работы и сбрасывает все настройки на этом устройстве, включая согласие на ИИ. Подписками управляет Apple — их нужно отменить отдельно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eserlerini siler ve yapay zekâ onayın dahil bu cihazdaki tüm ayarları sıfırlar. Abonelikler Apple tarafından yönetilir; ayrıca iptal etmen gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除你的作品，并重置此设备上的所有设置（包括 AI 处理授权）。订阅由 Apple 管理，需另行取消。"
          }
        }
      }
    },
    "Deletes your creations and resets every setting on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht deine Kreationen und setzt alle Einstellungen auf diesem Gerät zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tus creaciones y restablece todos los ajustes de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tes créations et réinitialise tous les réglages de cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus kreasimu dan mengatur ulang semua pengaturan di perangkat ini."
