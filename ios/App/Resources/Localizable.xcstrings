    "%@ asks Apple for your age range, never your birthday. It stays on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fragt bei Apple nur deine Altersgruppe ab, nie deinen Geburtstag. Sie bleibt auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ le pide a Apple tu rango de edad, nunca tu fecha de nacimiento. Se queda en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande à Apple ta tranche d’âge, jamais ta date de naissance. Elle reste sur cet appareil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hanya meminta rentang usiamu ke Apple, tidak pernah tanggal lahirmu. Datanya tetap di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ chiede ad Apple la tua fascia d'età, mai la tua data di nascita. Resta su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がAppleに確認するのは年齢層だけで、誕生日は聞きません。この情報は端末内にとどまります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은 Apple에 연령대만 물어보고, 생일은 절대 묻지 않아요. 이 정보는 이 기기에만 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ pede à Apple sua faixa etária, nunca sua data de nascimento. Ela fica neste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ запрашивает у Apple только твой возрастной диапазон, а не дату рождения. Он хранится на этом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Apple'dan doğum gününü değil, yalnızca yaş aralığını ister. Bu bilgi bu cihazda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 只会向 Apple 询问你的年龄段，绝不询问你的生日。这些信息只保存在这台设备上。"
          }
        }
      }
    },
