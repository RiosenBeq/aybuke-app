<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from the INFOPLIST_KEY_* build settings. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.glowlit.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>glowlit</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
		<string>instagram</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Developer AI keys from Config/Secrets.xcconfig (Debug only; empty in Release builds). -->
	<key>GLDirectAIProvider</key>
	<string>$(GL_AI_PROVIDER)</string>
	<key>GLDirectAIKey</key>
	<string>$(GL_AI_API_KEY)</string>
	<key>GLDirectAIImageModel</key>
	<string>$(GL_AI_IMAGE_MODEL)</string>
	<key>GLDirectAIEditModel</key>
	<string>$(GL_AI_EDIT_MODEL)</string>
</dict>
</plist>
