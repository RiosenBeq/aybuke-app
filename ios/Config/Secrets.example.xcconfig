// Developer AI key — copy this file to Secrets.xcconfig (it is git-ignored),
// fill in the values and run the app from Xcode. DEBUG builds only.
//
// GL_AI_PROVIDER: xai | fal | openai | gemini
//   xai     → key from https://console.x.ai                   (same models as the backend)
//   fal     → key from https://fal.ai/dashboard/keys
//   openai  → key from https://platform.openai.com/api-keys   (gpt-image-1)
//   gemini  → key from https://aistudio.google.com/apikey     (gemini-2.5-flash-image)
// Use a paid tier: some free tiers may use your requests to improve their models.
GL_AI_PROVIDER =
GL_AI_API_KEY =

// Optional model overrides; leave empty for the defaults above.
// Note: in .xcconfig files "//" starts a comment, so never paste URLs here.
GL_AI_IMAGE_MODEL =
GL_AI_EDIT_MODEL =
