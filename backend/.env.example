# Edge Function secrets — set them with:  supabase secrets set --env-file backend/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.)
# xAI API key (https://console.x.ai). When set, AI jobs run on xAI's Grok Imagine.
# In the xAI console, turn on Zero Data Retention for the team (selfies are personal data).
XAI_API_KEY=
# Optional: "xai" or "fal" (default: xai when XAI_API_KEY is set, otherwise fal).
AI_PROVIDER=
# Optional model overrides (default grok-imagine-image-2.0; grok-imagine-image is cheaper).
XAI_IMAGE_MODEL=
XAI_EDIT_MODEL=
# fal.ai API key (https://fal.ai/dashboard/keys). Optional with xAI. Every result passes one
# output check that fails closed (_shared/moderation.ts, no off switch): with FAL_KEY set it
# is fal.ai's NSFW classifier, so fal.ai sees the results; list fal.ai in the app's consent
# sheet (aiProcessors in ios/App/Resources/AppConfig.json) and the privacy policies before
# setting it. Without FAL_KEY, xAI's own moderation verdict is the check.
# Production AI calls only ever use server-side secrets.
FAL_KEY=
APPLE_BUNDLE_ID=app.glowlit.ios
# Numeric App Store app id (App Store Connect → App Information). Required to verify production purchases.
APPLE_APP_ID=
# Sign in with Apple token revocation on account deletion (Apple requires it).
# Create a "Sign in with Apple" key in Certificates, Identifiers & Profiles → Keys.
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
# Contents of the .p8 file; newlines may be written as \n.
APPLE_SIGNIN_PRIVATE_KEY=
# RevenueCat customer deletion when an account is deleted. Without the key, deletions wait in
# public.pending_revenuecat_deletions and go through once it is set (backend/README.md, step 6).
# Prefer a v2 secret key limited to customer_information:customers:read_write, plus the project id.
# A key without a project id is used with the v1 API; v1 and v2 keys are not interchangeable.
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
# Rewarded ads (functions/ad-reward): the AdMob rewarded ad unit(s) whose server-side
# verification callbacks may grant credits, comma-separated. Public ids, not secrets.
# Empty: every reward is refused (fail-closed).
ADMOB_REWARDED_AD_UNIT=ca-app-pub-2292230772061554/1406702504
